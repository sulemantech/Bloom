# Copy to .env.local. Values for local development come from `npx supabase status` (repo root).

# Supabase (Project Settings → API Keys in the online dashboard)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SECRET_KEY=

# Error tracking (optional locally)
NEXT_PUBLIC_SENTRY_DSN=

# Email through Resend (optional locally; emails are logged to the console instead)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Development only: lets parents, mentors and admins sign in with a password. Never enable in production.
ENABLE_DEV_PASSWORD_LOGIN=false

# One-click "Try the demo" buttons on the login page (e.g. a public demo site). Signs in to the demo
# accounts below; passwords stay on the server. Never enable where real families sign in.
ENABLE_DEMO_LOGIN=false
# Which demo accounts to offer (default: student,parent,mentor). Add admin only if you trust every visitor.
DEMO_LOGIN_ROLES=student,parent,mentor

# Demo accounts for `npm run seed:demo` and the demo buttons
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_MENTOR_PASSWORD=
DEMO_PARENT_PASSWORD=

# AI progress-card drafts (Claude). Optional: without it, the "Draft with AI" button explains it is not set up.
ANTHROPIC_API_KEY=
